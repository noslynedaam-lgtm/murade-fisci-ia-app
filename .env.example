# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# URLs públicas dos módulos Murade abertos pela central do Fisco IA.
VITE_MURADE_FISCAL_URL=https://murade-fiscal-1.onrender.com
VITE_MURADE_CONTABIL_URL=https://murade-contabil.onrender.com
VITE_MURADE_DP_URL=https://murade-dp.onrender.com

# SISTEMA
VITE_APP_NAME=FISCOIA
VITE_APP_ADMIN=MURADE
VITE_MAX_EMPRESAS=100

# PLANOS DE ASSINATURA
VITE_PLANO_BASICO_VALOR=199.90
VITE_PLANO_PROFISSIONAL_VALOR=349.90
VITE_PLANO_EMPRESARIAL_VALOR=599.90

# APIs
VITE_VIACEP_URL=https://viacep.com.br/ws
VITE_SERPRO_WS=https://servicos.receita.fazenda.gov.br
VITE_CAIXA_SEFIP_WS=https://sefip.caixa.gov.br/WSSefip

# BLOQUEIO
VITE_DIAS_AVISO_VENCIMENTO=7
VITE_DIAS_BLOQUEIO_AUTOMATICO=5
